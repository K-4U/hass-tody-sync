# Pulled Tody APKs (proprietary, large) and anything else holding real Tody data:
# app packages, emulator images, traffic captures. Never commit these.
apk/
*.apk
*.apks
*.xapk
*.avd/
*.img
*.qcow2
*.mitm
*.har
*.pcap
captures/

# Dev Home Assistant runtime data; only configuration.yaml is tracked
dev/config/*
!dev/config/configuration.yaml

__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store
dev/.dev-credentials
